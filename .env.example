# Monsieur Fanyi — Variables d'Environnement (Exemple de Configuration)
# Ne jamais consigner de clés de production réelles dans le gestionnaire de versions.

# Environnement de l'application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de données PostgreSQL (Recommandée en production) ou SQLite en local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monsieur_fanyi?schema=public"

# Clé secrète de session et chiffrement JWT (Générer une clé aléatoire forte en production)
AUTH_SECRET="fanyi_dev_super_secret_session_key_32_characters_minimum"

# Commission contractuelle par défaut (15 % pour la plateforme)
DEFAULT_PLATFORM_COMMISSION_PERCENT=15

# Configuration des passerelles Mobile Money (Mode Sandbox / Mock pour le MVP)
PAYMENT_MOCK_ENABLED=true
ORANGE_MONEY_API_KEY=""
ORANGE_MONEY_MERCHANT_CODE=""
MTN_MOMO_API_KEY=""
MTN_MOMO_USER_ID=""

# Stockage de fichiers (Stockage local ou compatible S3 en production)
STORAGE_PROVIDER="local"
UPLOAD_MAX_FILE_SIZE_MB=5

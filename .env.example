# Monsieur Fanyi — Environment Variables Example
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monsieur_fanyi?schema=public"

# Authentication & Session Secrets
AUTH_SECRET="fanyi_production_grade_secret_key_minimum_32_characters_here"
SESSION_MAX_AGE_SECONDS=604800 # 7 days

# Initial Admin Bootstrap (Used by npm run db:seed:admin)
ADMIN_BOOTSTRAP_EMAIL="admin@monsieurfanyi.gn"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMeInProduction2026!"
ADMIN_BOOTSTRAP_NAME="Administrateur National Monsieur Fanyi"

# Email Delivery & Transactional Messaging (Resend + Durable Outbox)
# When RESEND_API_KEY is not set or empty, system runs safely in mock sandbox mode.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="Monsieur Fanyi <notifications@monsieurfanyi.com>"
EMAIL_REPLY_TO="support@monsieurfanyi.com"
EMAIL_ENABLED=true

# SMTP Transport Credentials (Alternative/Legacy SMTP transport)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_USER="resend"
SMTP_PASSWORD=""

# Scheduled Background Tasks & Cron Security
CRON_SECRET="fanyi_production_cron_secret_minimum_32_characters_here"

# Business & Payment Parameters
DEFAULT_PLATFORM_COMMISSION_PERCENT=15
PAYMENT_MOCK_ENABLED=true
STORAGE_PROVIDER="local"
UPLOAD_MAX_FILE_SIZE_MB=5

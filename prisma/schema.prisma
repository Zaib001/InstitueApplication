datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  PARENT
  TEACHER
  ADMIN
  STUDENT
}

enum TeacherVerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  DIPLOMA
  POLICE_RECORD
  CV
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PricingOfferType {
  HOURLY
  MONTHLY_PACKAGE
}

enum TutoringMode {
  HOME
  ONLINE
  HYBRID
}

enum RequestStatus {
  DRAFT
  OPEN
  ASSIGNED
  MATCHED
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ClassroomStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum PackageStatus {
  DRAFT
  PROPOSED
  AGREED
  PENDING_PAYMENT
  FUNDED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  SCHEDULED
  RESCHEDULED
  IN_PROGRESS
  TEACHER_COMPLETED
  PARENT_APPROVED
  PARENT_DISPUTED
  ADMIN_RESOLVED
  CANCELLED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  RETURNED_FOR_CORRECTION
  VALIDATED
  DISPUTED
}

enum HomeworkStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  COMPLETED
}

enum AssessmentType {
  DIAGNOSTIC
  WEEKLY_QUIZ
  MONTHLY_EXAM
  TOPIC_TEST
  PRACTICE_EXAM
}

enum LessonAttendance {
  PRESENT
  ABSENT_STUDENT
  ABSENT_TEACHER
  EXCUSED
  LATE
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentAttemptStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
}

enum LedgerEntryType {
  PARENT_PAYMENT
  TEACHER_EARNING
  PLATFORM_COMMISSION
  TEACHER_PAYOUT
  REFUND
  ADJUSTMENT
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_VALIDATED
  RESOLVED_REFUNDED
  RESOLVED_RESCHEDULED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

enum NotificationEventType {
  AUTH_WELCOME
  AUTH_ACTIVATION
  AUTH_PASSWORD_RESET
  AUTH_PASSWORD_CHANGED
  TEACHER_REGISTERED
  TEACHER_SUBMITTED_FOR_REVIEW
  TEACHER_VERIFIED
  TEACHER_REJECTED
  TEACHER_DOCUMENTS_REQUESTED
  TEACHER_APPLICATION_RECEIVED
  TEACHER_SHORTLISTED
  TEACHER_SELECTED
  TEACHER_APPLICATION_REJECTED
  TEACHER_APPLICATION_WITHDRAWN
  OPPORTUNITY_MATCHED
  ADMIN_CLASSROOM_ASSIGNED
  CLASSROOM_STATUS_CHANGED
  PACKAGE_CONFIRMED
  PACKAGE_PAYMENT_REQUIRED
  SCHEDULE_CREATED
  SCHEDULE_CHANGED
  LESSON_CANCELLED
  LESSON_REMINDER
  ATTENDANCE_RECORDED
  LESSON_REPORT_SUBMITTED
  LESSON_APPROVED
  DISPUTE_OPENED
  DISPUTE_TEACHER_RESPONDED
  DISPUTE_RESOLVED
  HOMEWORK_ASSIGNED
  HOMEWORK_SUBMITTED
  HOMEWORK_GRADED
  ASSESSMENT_RECORDED
  PROGRESS_OBSERVATION_RECORDED
  ACADEMIC_PROGRESS_DIGEST
  ADMIN_ALERT
  // Milestone 3 prepared (inactive)
  PAYMENT_INITIATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  PACKAGE_FUNDED
  PAYOUT_PENDING
  PAYOUT_COMPLETED
  REFUND_PROCESSED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  RETRY_SCHEDULED
  PERMANENT_FAILURE
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phoneNumber  String?  @unique
  role         UserRole @default(PARENT)
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentProfile           ParentProfile?
  teacherProfile          TeacherProfile?
  studentProfile          StudentProfile?
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  sentMessages            ClassroomMessage[]
  uploadedAttachments     Attachment[]
  adminAssignedClassrooms Classroom[]              @relation("AdminAssignedClassrooms")
  invitationTokens        AccountInvitationToken[]
  legalAcceptances        LegalAcceptance[]

  @@index([role])
  @@index([email])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionToken])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model AccountInvitationToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  usedAt           DateTime?
  invitedByAdminId String?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model ParentProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address                String?
  city                   String    @default("Conakry")
  isAssistedRegistration Boolean   @default(false)
  termsAccepted          Boolean   @default(false)
  termsAcceptedAt        DateTime?
  termsVersion           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime @updatedAt

  children         StudentProfile[]
  tutoringRequests TutoringRequest[]
  ratings          Rating[]

  @@index([userId])
}

model StudentProfile {
  id                String        @id @default(cuid())
  parentId          String
  parent            ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  userId            String?       @unique
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName          String
  gradeLevel        String
  cycle             String? // PRIMAIRE, COLLEGE, LYCEE, SUPERIEUR, AUTRE
  customCycle       String? // Spécification si cycle === "AUTRE" (ex: Formation Pro)
  customSubject     String? // Spécification matière personnalisée si "Autre"
  schoolName        String?
  dateOfBirth       DateTime?
  supportNeeds      String? // Academic challenges & learning goals
  preferredSubjects String[]      @default([])
  notes             String? // Optional educational notes from parent
  isArchived        Boolean       @default(false)
  archivedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tutoringRequests     TutoringRequest[]
  classrooms           Classroom[]
  homework             HomeworkAssignment[]
  assessments          AcademicAssessment[]
  progressObservations SubjectProgressObservation[]

  @@index([parentId])
  @@index([isArchived])
}

model TeacherProfile {
  id                            String                    @id @default(cuid())
  userId                        String                    @unique
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline                      String?
  bio                           String?
  yearsOfExperience             Int                       @default(0)
  city                          String                    @default("Conakry")
  serviceArea                   String?
  degrees                       String?
  institution                   String?
  isHomeAvailable               Boolean                   @default(true)
  isOnlineAvailable             Boolean                   @default(true)
  hourlyRateGnf                 Int?
  monthlyPackageRateGnf         Int?
  monthlyPackageSessions        Int?                      @default(8)
  monthlyPackageHoursPerSession Int?                      @default(2)
  customSubject                 String? // Spécification matière personnalisée si "Autre"
  customGradeLevel              String? // Spécification cycle / niveau personnalisé si "Autre"
  verificationStatus            TeacherVerificationStatus @default(DRAFT)
  rejectionReason               String?
  submittedAt                   DateTime?
  reviewedAt                    DateTime?
  reviewerId                    String?
  verifiedAt                    DateTime?
  termsAccepted                 Boolean                   @default(false)
  termsAcceptedAt               DateTime?
  termsVersion                  String?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt

  subjects             TeacherSubject[]
  gradeLevels          TeacherGradeLevel[]
  documents            TeacherDocument[]
  pricingOffers        TeacherPricingOffer[]
  availabilities       Availability[]
  applications         TeacherApplication[]
  classrooms           Classroom[]
  earnings             TeacherEarning[]
  payouts              Payout[]
  ratings              Rating[]
  homework             HomeworkAssignment[]
  assessments          AcademicAssessment[]
  progressObservations SubjectProgressObservation[]

  @@index([userId])
  @@index([verificationStatus])
}

model TeacherSubject {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([teacherProfileId, subjectId])
  @@index([teacherProfileId])
  @@index([subjectId])
}

model TeacherGradeLevel {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  gradeLevelId     String
  gradeLevel       GradeLevel     @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([teacherProfileId, gradeLevelId])
  @@index([teacherProfileId])
  @@index([gradeLevelId])
}

model TeacherDocument {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  type             DocumentType
  title            String
  fileUrl          String
  mimeType         String
  fileSizeBytes    Int
  status           DocumentStatus @default(PENDING)
  rejectionReason  String?
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([teacherProfileId])
  @@index([status])
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  teacherSubjects TeacherSubject[]
}

model GradeLevel {
  id         String @id @default(cuid())
  name       String @unique
  cycle      String // PRIMAIRE, COLLEGE, LYCEE, SUPERIEUR
  orderIndex Int    @default(0)

  teacherGradeLevels TeacherGradeLevel[]
}

model TeacherPricingOffer {
  id                String           @id @default(cuid())
  teacherProfileId  String
  teacherProfile    TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  type              PricingOfferType @default(HOURLY)
  title             String
  totalPriceGnf     Int
  sessionsCount     Int              @default(1)
  minutesPerSession Int              @default(60)
  description       String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  orders       PaymentOrder[]
  applications TeacherApplication[]

  @@index([teacherProfileId])
}

model TutoringRequest {
  id                     String         @id @default(cuid())
  parentId               String
  parent                 ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId              String
  student                StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId              String?
  subjectName            String
  customSubject          String? // Spécification matière personnalisée si "Autre"
  cycle                  String? // PRIMAIRE, COLLEGE, LYCEE, SUPERIEUR, AUTRE
  customCycle            String? // Spécification cycle / niveau personnalisé si "Autre"
  gradeLevelName         String
  mode                   TutoringMode   @default(HOME)
  frequency              String? // ex: "1_WEEKLY", "2_WEEKLY", "3_WEEKLY", "INTENSIVE", "WEEKEND"
  preferredSchedule      String? // ex: "Mardi et Jeudi 16h-18h, Samedi 10h-12h"
  sessionDurationMinutes Int            @default(120)
  budgetGnf              Int            @default(800000)
  budgetType             String         @default("MONTHLY") // "MONTHLY" | "HOURLY"
  city                   String         @default("Conakry")
  commune                String? // Kaloum, Dixinn, Matam, Ratoma, Matoto, etc.
  neighborhood           String? // Kipé, Taouyah, Lambanyi, etc.
  locationAddress        String? // Adresse exacte confidentielle (domicile)
  learningGoals          String? // Objectifs d'apprentissage prioritaires
  description            String         @default("") // Description globale ou remarques
  notes                  String? // Remarques éducatives additionnelles
  status                 RequestStatus  @default(DRAFT)
  isAssisted             Boolean        @default(false)
  publishedAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  applications TeacherApplication[]
  classroom    Classroom?

  @@index([parentId])
  @@index([studentId])
  @@index([status])
}

model TeacherApplication {
  id                 String               @id @default(cuid())
  requestId          String
  request            TutoringRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teacherProfileId   String
  teacherProfile     TeacherProfile       @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  pitchMessage       String? // Message de motivation de l'enseignant
  proposedRateGnf    Int? // Tarif proposé en GNF
  proposedRateType   String               @default("MONTHLY") // "MONTHLY" | "HOURLY"
  sessionArrangement String? // Modalités et fréquence proposées (ex: 2 séances de 2h/semaine)
  availabilityNotes  String? // Créneaux horaires et disponibilités
  pricingOfferId     String? // Formule tarifaire associée si sélectionnée
  pricingOffer       TeacherPricingOffer? @relation(fields: [pricingOfferId], references: [id], onDelete: SetNull)
  status             ApplicationStatus    @default(SUBMITTED)
  isAssisted         Boolean              @default(false)
  rejectionReason    String? // Motif en cas de refus
  withdrawnAt        DateTime? // Date de retrait par l'enseignant
  decisionAt         DateTime? // Date de décision parent/admin
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([requestId, teacherProfileId])
  @@index([requestId])
  @@index([teacherProfileId])
  @@index([status])
  @@index([teacherProfileId, status])
  @@index([requestId, status])
}

model Classroom {
  id                   String           @id @default(cuid())
  requestId            String?          @unique
  request              TutoringRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  teacherProfileId     String
  teacherProfile       TeacherProfile   @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  studentId            String
  student              StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subjectName          String
  mode                 TutoringMode     @default(HOME)
  hourlyRateGnf        Int?
  monthlyRateGnf       Int?
  isAssistedAssignment Boolean          @default(false)
  assignedByAdminId    String?
  assignedByAdmin      User?            @relation("AdminAssignedClassrooms", fields: [assignedByAdminId], references: [id], onDelete: SetNull)
  adminNotes           String?
  assignmentSource     String? // e.g. "PHONE_INQUIRY", "DIRECT_OFFICE", "ADMIN_MATCH"
  externalVideoUrl     String?
  status               ClassroomStatus  @default(PENDING_PAYMENT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  sessions             LessonSession[]
  messages             ClassroomMessage[]
  orders               PaymentOrder[]
  packages             TutoringPackage[]
  attachments          Attachment[]
  homework             HomeworkAssignment[]
  assessments          AcademicAssessment[]
  progressObservations SubjectProgressObservation[]

  @@index([teacherProfileId])
  @@index([studentId])
  @@index([isAssistedAssignment])
  @@index([assignedByAdminId])
}

model LessonSession {
  id                     String           @id @default(cuid())
  classroomId            String
  classroom              Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  packageId              String?
  package                TutoringPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  sessionSequence        Int              @default(1)
  title                  String? // Titre ou objectif pédagogique de la séance
  scheduledStart         DateTime
  scheduledEnd           DateTime
  actualStart            DateTime?
  actualEnd              DateTime?
  durationMinutes        Int              @default(60)
  actualDurationMinutes  Int?
  attendanceStatus       LessonAttendance @default(PRESENT)
  attendanceRecordedAt   DateTime?
  attendanceRecordedById String?
  attendanceNotes        String?
  allocatedAmountGnf     Int              @default(0)
  platformCommissionGnf  Int              @default(0)
  teacherNetGnf          Int              @default(0)
  isFunded               Boolean          @default(false)
  status                 SessionStatus    @default(SCHEDULED)

  // Audit reprogrammation
  rescheduledFromStart DateTime?
  rescheduledFromEnd   DateTime?
  rescheduleReason     String?
  rescheduledById      String?

  // Audit annulation
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report      LessonReport?
  approval    LessonApproval?
  dispute     LessonDispute?
  earning     TeacherEarning?
  refundCases RefundCase[]
  homework    HomeworkAssignment[]
  assessments AcademicAssessment[]

  @@index([classroomId])
  @@index([packageId])
  @@index([status])
  @@index([attendanceStatus])
  @@index([scheduledStart])
}

model LessonReport {
  id                        String        @id @default(cuid())
  sessionId                 String        @unique
  session                   LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status                    ReportStatus  @default(DRAFT)
  topicsCovered             String
  learningObjectives        String? // Objectifs pédagogiques abordés
  studentEffort             String? // Participation / implication de l'élève
  teacherNotes              String? // Observations générales
  strengths                 String? // Points forts constatés
  areasForImprovement       String? // Difficultés rencontrées / axes de progrès
  homeworkGiven             String? // Devoirs assignés
  homeworkDueDate           DateTime? // Date limite des devoirs
  nextLessonRecommendations String? // Recommandations pour la séance suivante
  assessmentTitle           String? // Titre du contrôle / évaluation éventuelle
  assessmentScore           Float? // Note obtenue
  assessmentMaxScore        Float? // Note maximale (ex: 20)
  assessmentComment         String? // Commentaire sur l'évaluation
  progressRating            Int? // Évaluation globale 1 à 5 étoiles
  version                   Int           @default(1)
  revisionNotes             String? // Notes en cas de correction demandée
  originalReportJson        String? // Sauvegarde de la version originale si modifiée
  draftSavedAt              DateTime? // Date d'enregistrement du dernier brouillon
  submittedAt               DateTime? // Date de soumission formelle pour validation
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @default(now()) @updatedAt

  @@index([sessionId])
  @@index([status])
}

model LessonApproval {
  id                    String        @id @default(cuid())
  sessionId             String        @unique
  session               LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvedBy            String
  approvedAt            DateTime      @default(now())
  feedbackNote          String?
  reportVersionReviewed Int?          @default(1)

  @@index([sessionId])
}

model LessonDispute {
  id                 String        @id @default(cuid())
  sessionId          String        @unique
  session            LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  openedBy           String
  category           String? // LESSON_NOT_HELD, INCORRECT_DURATION, ATTENDANCE_DISAGREEMENT, INCOMPLETE_TEACHING, INCORRECT_REPORT, OTHER
  reason             String // Description du litige par le parent
  teacherResponse    String? // Réponse explicative de l'enseignant
  teacherRespondedAt DateTime? // Horodatage de la réponse de l'enseignant
  status             DisputeStatus @default(OPEN)
  resolutionType     String? // RESOLVED_VALIDATED, RESOLVED_REFUNDED, RESOLVED_RESCHEDULED
  adminNote          String? // Décision et notes administratives
  resolvedById       String? // Administrateur ayant statué
  resolvedAt         DateTime? // Horodatage de la résolution
  refundCase         RefundCase?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([sessionId])
  @@index([status])
}

model ClassroomMessage {
  id            String       @id @default(cuid())
  classroomId   String
  classroom     Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content       String
  attachmentUrl String?
  attachments   Attachment[]
  createdAt     DateTime     @default(now())

  @@index([classroomId])
  @@index([senderId])
}

model HomeworkAssignment {
  id                String         @id @default(cuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherProfileId  String
  teacherProfile    TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classroomId       String
  classroom         Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  sessionId         String?
  session           LessonSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  subjectName       String
  title             String
  description       String
  dueDate           DateTime?
  status            HomeworkStatus @default(ASSIGNED)
  studentSubmission String?
  submittedAt       DateTime?
  teacherFeedback   String?
  reviewedAt        DateTime?
  completedAt       DateTime?
  attachmentUrl     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([studentId])
  @@index([classroomId])
  @@index([teacherProfileId])
  @@index([status])
  @@index([dueDate])
}

model AcademicAssessment {
  id                 String         @id @default(cuid())
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherProfileId   String
  teacherProfile     TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classroomId        String
  classroom          Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  sessionId          String?
  session            LessonSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  subjectName        String
  title              String
  assessmentType     AssessmentType @default(TOPIC_TEST)
  assessmentDate     DateTime       @default(now())
  obtainedScore      Float
  maxScore           Float          @default(20)
  percentage         Float // Pourcentage normalisé (0 à 100)
  learningObjectives String?
  teacherComments    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([studentId])
  @@index([classroomId])
  @@index([teacherProfileId])
  @@index([subjectName])
  @@index([assessmentDate])
}

model SubjectProgressObservation {
  id                  String         @id @default(cuid())
  studentId           String
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherProfileId    String
  teacherProfile      TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  classroomId         String
  classroom           Classroom      @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectName         String
  observationDate     DateTime       @default(now())
  topicsMastered      String?
  strengths           String?
  areasForImprovement String?
  recommendations     String?
  progressRating      Int? // Évaluation globale 1-5 étoiles
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([studentId])
  @@index([classroomId])
  @@index([subjectName])
}

model TutoringPackage {
  id                         String           @id @default(cuid())
  classroomId                String
  classroom                  Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  pricingType                PricingOfferType @default(MONTHLY_PACKAGE)
  hourlyRateGnf              Int?
  totalAmountGnf             Int
  sessionsCount              Int              @default(8)
  minutesPerSession          Int              @default(60)
  totalPlannedMinutes        Int              @default(480)
  baseSessionRateGnf         Int
  remainderGnf               Int              @default(0)
  commissionRatePercent      Int              @default(15)
  totalPlatformCommissionGnf Int
  totalTeacherShareGnf       Int
  allocationsJson            String? // JSON des allocations exactes par séance
  status                     PackageStatus    @default(PENDING_PAYMENT)
  notes                      String?
  version                    Int              @default(1)
  agreedAt                   DateTime?
  fundedAt                   DateTime?
  completedAt                DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  orders   PaymentOrder[]
  sessions LessonSession[]

  @@index([classroomId])
  @@index([status])
}

// ----------------------------------------------------
// FINANCIAL ENGINE & COMMISSION
// ----------------------------------------------------

model CommissionRule {
  id             String   @id @default(cuid())
  ratePercentage Int      @default(15) // SRD V2.0 : 15 %
  description    String?
  effectiveFrom  DateTime @default(now())
  createdByAdmin String
  createdAt      DateTime @default(now())

  @@index([effectiveFrom])
}

model PaymentOrder {
  id             String               @id @default(cuid())
  classroomId    String?
  classroom      Classroom?           @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  packageId      String?
  package        TutoringPackage?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  pricingOfferId String?
  pricingOffer   TeacherPricingOffer? @relation(fields: [pricingOfferId], references: [id], onDelete: SetNull)
  parentUserId   String
  totalAmountGnf Int
  status         PaymentOrderStatus   @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  attempts      PaymentAttempt[]
  ledgerEntries PaymentLedgerEntry[]
  refundCases   RefundCase[]

  @@index([parentUserId])
  @@index([status])
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  orderId           String
  order             PaymentOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String // ORANGE_MONEY, MTN_MOMO, MANUAL_RECONCILE
  idempotencyKey    String               @unique
  providerReference String?
  amountGnf         Int
  status            PaymentAttemptStatus @default(INITIATED)
  rawResponse       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  providerEvents PaymentProviderEvent[]

  @@index([orderId])
  @@index([providerReference])
}

model PaymentProviderEvent {
  id                String         @id @default(cuid())
  attemptId         String
  attempt           PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventName         String
  payloadJson       String
  signatureReceived String?
  createdAt         DateTime       @default(now())

  @@index([attemptId])
}

model TeacherEarning {
  id                    String         @id @default(cuid())
  teacherProfileId      String
  teacherProfile        TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  sessionId             String         @unique
  session               LessonSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  grossAmountGnf        Int
  commissionRatePercent Int            @default(15)
  platformCommissionGnf Int
  teacherNetGnf         Int
  isPaidOut             Boolean        @default(false)
  payoutId              String?
  payout                Payout?        @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  createdAt             DateTime       @default(now())

  @@index([teacherProfileId])
  @@index([sessionId])
  @@index([isPaidOut])
}

model Payout {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Restrict)
  amountGnf        Int
  paymentReference String         @unique // Référence opérateur unique pour bloquer le double-versement
  beneficiaryName  String
  beneficiaryPhone String
  channel          String // ORANGE_MONEY, MTN_MOMO, CASH, BANK
  status           PayoutStatus   @default(PAID)
  recordedByAdmin  String
  createdAt        DateTime       @default(now())

  earnings TeacherEarning[]

  @@index([teacherProfileId])
  @@index([paymentReference])
}

model PaymentLedgerEntry {
  id          String          @id @default(cuid())
  orderId     String?
  order       PaymentOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        LedgerEntryType
  amountGnf   Int
  description String
  actorId     String
  reference   String?
  createdAt   DateTime        @default(now())

  @@index([orderId])
  @@index([type])
}

model Rating {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  parentProfileId  String
  parentProfile    ParentProfile  @relation(fields: [parentProfileId], references: [id], onDelete: Cascade)
  score            Int // 1 à 5
  comment          String?
  isPublic         Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@unique([teacherProfileId, parentProfileId])
  @@index([teacherProfileId])
}

model Notification {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  NotificationEventType @default(ADMIN_ALERT)
  priority   NotificationPriority  @default(NORMAL)
  title      String
  message    String
  linkUrl    String?
  entityType String?
  entityId   String?
  isRead     Boolean               @default(false)
  readAt     DateTime?
  dedupKey   String?
  createdAt  DateTime              @default(now())

  emailOutbox EmailOutbox?

  @@index([userId])
  @@index([isRead])
  @@index([eventType])
  @@index([priority])
  @@index([dedupKey])
}

model EmailOutbox {
  id                   String                @id @default(cuid())
  notificationId       String?               @unique
  notification         Notification?         @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  eventType            NotificationEventType
  recipientEmail       String
  recipientName        String?
  subject              String
  templateName         String
  locale               String                @default("fr")
  payloadJson          String                @default("{}")
  status               EmailDeliveryStatus   @default(PENDING)
  attempts             Int                   @default(0)
  maxAttempts          Int                   @default(5)
  nextAttemptAt        DateTime              @default(now())
  lastError            String?
  providerMessageId    String?
  providerResponseJson String?
  dedupKey             String                @unique
  sentAt               DateTime?
  deliveredAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([status])
  @@index([nextAttemptAt])
  @@index([recipientEmail])
  @@index([eventType])
  @@index([dedupKey])
}

model NotificationPreference {
  id                            String   @id @default(cuid())
  userId                        String   @unique
  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailLessonReminders          Boolean  @default(true)
  emailReportSubmitted          Boolean  @default(true)
  emailHomeworkAssigned         Boolean  @default(true)
  emailAssessmentRecorded       Boolean  @default(true)
  emailProgressDigest           Boolean  @default(true)
  emailMarketplaceOpportunities Boolean  @default(false)
  emailMarketing                Boolean  @default(false)
  inAppAll                      Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  detailsJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

model Availability {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  dayOfWeek        Int // 0 = Dimanche, 1 = Lundi, ..., 6 = Samedi
  startTime        String // ex: "08:00"
  endTime          String // ex: "12:00"
  isRecurring      Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@index([teacherProfileId])
  @@index([dayOfWeek])
}

model Attachment {
  id            String            @id @default(cuid())
  classroomId   String?
  classroom     Classroom?        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  messageId     String?
  message       ClassroomMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploaderId    String
  uploader      User              @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  mimeType      String
  fileSizeBytes Int
  createdAt     DateTime          @default(now())

  @@index([classroomId])
  @@index([messageId])
  @@index([uploaderId])
}

model RefundCase {
  id                 String         @id @default(cuid())
  orderId            String
  order              PaymentOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sessionId          String?
  session            LessonSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  disputeId          String?        @unique
  dispute            LessonDispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  requestedAmountGnf Int
  approvedAmountGnf  Int?
  status             RefundStatus   @default(REQUESTED)
  reason             String
  adminDecisionNotes String?
  processedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
}

model LegalAcceptance {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String   // "CGU" | "CHARTE_PEDAGOGIQUE" | "NON_CIRCUMVENTION"
  documentVersion String   // "V2.1-2026-NC"
  context         String   // "REGISTRATION" | "RE_ACCEPTANCE"
  ipAddress       String?
  userAgent       String?
  acceptedAt      DateTime @default(now())

  @@index([userId])
  @@index([documentType, documentVersion])
}

model ContactInquiry {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  status    String   @default("NEW") // "NEW" | "READ" | "REPLIED" | "ARCHIVED"
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

